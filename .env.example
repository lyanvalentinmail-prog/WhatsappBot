########################################
#   CONFIGURACIÓN DEL BOT DE WHATSAPP   #
########################################
# Copia este archivo como ".env" y completa los valores:
#   cp .env.example .env
#   nano .env

# ---- Identidad del bot ----
BOT_NAME=MiBot
BOT_OWNER=Lyan
# Prefijo usado para los comandos. Ej: . ! # /
BOT_PREFIX=.
# Permite ejecutar comandos sin escribir el prefijo (true/false)
ALLOW_NO_PREFIX=false
# private  -> solo el owner puede usar el bot
# public   -> cualquier persona puede usar el bot
BOT_MODE=public
# Idioma de los mensajes del bot (actualmente: es)
LANGUAGE=es
# Estilo del menú: default | compacto
MENU_STYLE=default

# ---- Conexión ----
# Número de teléfono con código de país, sin "+" ni espacios (ej: 5491122334455)
# Solo se usa si USE_PAIRING_CODE=true
PAIRING_NUMBER=
# true  -> conectar con código de vinculación (pairing code)
# false -> conectar escaneando el código QR
USE_PAIRING_CODE=false

# ---- Información mostrada en el menú ----
GROUP_LINK=
DEVELOPER_NAME=Lyan
DEVELOPER_NUMBER=5491100000000
GITHUB_REPO=https://github.com/lyanvalentinmail-prog/WhatsappBot

# ---- APIs de Inteligencia Artificial ----
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Modelos usados por defecto (puedes cambiarlos sin tocar el código)
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# ---- APIs de descargas (opcional, configurable) ----
# URL base de tu propia API/microservicio de descargas (YouTube, TikTok, etc.)
DOWNLOAD_API_URL=
DOWNLOAD_API_KEY=

# ---- Base de datos ----
# json  -> usa el almacenamiento interno en archivos JSON (por defecto, cero configuración)
# sqlite-> (preparado para futura implementación)
DATABASE_DRIVER=json
DATABASE_URL=./src/database/storage/database.json

# ---- Otros ----
# Zona horaria usada para mostrar horas (ej: America/Montevideo)
TIMEZONE=America/Montevideo
